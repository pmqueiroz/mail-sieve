{name === 'mark' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
    <path d="M4 7h16M7 12h10M10 17h4" />
  </svg>
)}
