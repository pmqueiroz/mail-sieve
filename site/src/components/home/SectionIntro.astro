---
interface Props {
  title?: string;
  align?: 'start' | 'center';
  size?: 'lg' | 'md';
  id?: string;
  class?: string;
}

const { title, align = 'start', size = 'lg', id, class: className } = Astro.props;
---

<div id={id} class:list={['flex flex-col gap-10', align === 'center' && 'items-center text-center', className]}>
  <h2
    class:list={[
      'm-0 max-w-heading leading-tight font-bold tracking-display text-balance',
      size === 'lg' ? 'text-section' : 'text-section-sm',
    ]}
  >
    <slot name="title">{title}</slot>
  </h2>
  <p class="m-0 max-w-intro text-lead text-pretty text-ink-2"><slot /></p>
</div>
