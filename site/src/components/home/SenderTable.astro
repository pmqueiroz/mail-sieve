---
const senders = [
  { name: 'LinkedIn', count: 4812, size: '612 MB', tint: 'bg-tile-blue' },
  { name: 'Amazon', count: 3201, size: '418 MB', tint: 'bg-tile-orange' },
  { name: 'Medium Daily Digest', count: 2654, size: '201 MB', tint: 'bg-tile-green' },
  { name: 'GitHub', count: 2190, size: '88 MB', tint: 'bg-tile-violet' },
  { name: 'Uber Eats', count: 1407, size: '156 MB', tint: 'bg-tile-pink' },
];
const top = Math.max(...senders.map((s) => s.count));
const columns = 'grid grid-cols-[minmax(0,1fr)_--spacing(36)_--spacing(32)] gap-6';
---

<div role="table" aria-label="Example senders ranked by message count">
  <div role="row" class:list={[columns, 'border-b border-line px-2 pb-5 text-xs text-ink-3']}>
    <span role="columnheader">Sender</span>
    <span role="columnheader" class="text-right">Messages</span>
    <span role="columnheader" class="text-right">Size</span>
  </div>
  {senders.map((s) => (
    <div role="row" class:list={[columns, 'h-27 items-center border-b border-hairline px-2']}>
      <span role="cell" class="flex min-w-0 items-center gap-5">
        <span class:list={['grid size-14 flex-none place-items-center rounded-sm text-xs font-bold text-tile-ink', s.tint]}>
          {s.name[0]}
        </span>
        <span class="flex min-w-0 flex-1 flex-col leading-row">
          <span class="truncate text-base font-semibold">{s.name}</span>
          <span class="mt-3 h-1.5 rounded-bar bg-accent" style={`width:${Math.round((s.count / top) * 100)}%`}></span>
        </span>
      </span>
      <span role="cell" class="text-right text-base font-semibold tabular-nums">{s.count.toLocaleString('en-US')}</span>
      <span role="cell" class="text-right text-base text-ink-2 tabular-nums">{s.size}</span>
    </div>
  ))}
</div>
