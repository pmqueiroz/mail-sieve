---
import Icon from '../Icon.astro';
import PillLink from '../PillLink.astro';

interface Props {
  href: string;
  icon: 'heart' | 'patreon';
  title: string;
  cta: string;
  variant: 'primary' | 'outline';
}

const { href, icon, title, cta, variant } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="flex flex-col gap-7 rounded-card border border-line bg-surface p-14 text-ink no-underline hover:border-accent hover:text-ink"
>
  <div class="flex items-center gap-6">
    <span class:list={['grid size-20 place-items-center rounded-lg bg-ink', icon === 'heart' ? 'text-sponsor' : 'text-btn-ink']}>
      <Icon name={icon} size={20} />
    </span>
    <span class="text-xl font-bold tracking-heading">{title}</span>
  </div>
  <p class="m-0 text-base text-pretty text-ink-2"><slot /></p>
  <PillLink as="span" variant={variant} class="mt-2 self-start font-bold">{cta}</PillLink>
</a>
